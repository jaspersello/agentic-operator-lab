        208
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "8d731ea2-c7c3-4ebd-a39e-dcb381f79613",
              "name": "Tier",
              "value": "=={{ (() => { try { return JSON.parse($json.claude_raw).tier; } catch (e) { return 'PARSE_ERROR'; } })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
